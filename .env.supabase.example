# Depo kökündeki `.env.supabase` olarak kopyalayın (dosya .gitignore'da).
# `npm run supabase:kur` bunu okur. Ayrıntı: supabase/README.md

# ── Yol A: mevcut proje ──────────────────────────────────────────────
# supabase.com → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=sbp_...
# Proje adresindeki kod: https://supabase.com/dashboard/project/<BU>
SUPABASE_PROJECT_REF=

# ── Yol B: yeni proje (npm run supabase:kur -- --proje-olustur) ───────
# SUPABASE_ORG_ID=            # kuruluş slug'ı
# SUPABASE_DB_PASSWORD=       # yeni, güçlü, tek kullanımlık görünen bir parola
# SUPABASE_REGION=eu-central-1
# SUPABASE_PROJECT_NAME=gur

# ── Yol C: doğrudan veritabanı ───────────────────────────────────────
# SUPABASE_DB_URL=postgres://postgres:...@db.<ref>.supabase.co:5432/postgres
# SUPABASE_DB_SSL=no-verify   # yalnızca sertifika zinciri hatası alırsanız

# ── İsteğe bağlı ─────────────────────────────────────────────────────
# Yönetici hesabı (varsayılan YOK; en az 8 karakter)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# E-posta doğrulamayı kapatır — yalnızca geliştirme
# SUPABASE_AUTO_CONFIRM=1
