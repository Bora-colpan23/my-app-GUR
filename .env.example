# ═══════════════════════════════════════════════════════════════════════
# GUR — ortam değişkenleri
# Kopyala: cp .env.example .env   (.env git'e girmez, .gitignore'da)
# ═══════════════════════════════════════════════════════════════════════

# ─── Zorunlu ───────────────────────────────────────────────────────────
DATABASE_URL=postgres://gur:gur_dev@127.0.0.1:5432/gur

# Oturum belirteçlerinin HMAC anahtarı. Üretimde MUTLAKA kendi rastgele
# değerinizi verin: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Tanımsızsa süreç başına rastgele üretilir ve yeniden başlatmada tüm
# oturumlar düşer.
SESSION_SECRET=

# ─── İsteğe bağlı ──────────────────────────────────────────────────────
PORT=8787
# Üretimde "*" bırakmayın; uygulamanızın kaynağını yazın.
CORS_ORIGIN=*
# Zamanlanmış işleri kapatmak için 1
DISABLE_CRON=0

# Tohumlama sırasında oluşturulan yönetici hesabı
ADMIN_USER=admin
ADMIN_PASSWORD=gur2026

# ─── Mekan havuzu beslemesi ────────────────────────────────────────────
# Hiçbiri tanımlı değilse besleme yalnızca OpenStreetMap ile çalışır
# (ücretsiz, anahtarsız). Hepsi boşsa sistem yine ayakta kalır.
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=
TRIPADVISOR_API_KEY=

# ─── Sosyal giriş ──────────────────────────────────────────────────────
# Sunucu: id_token doğrulamasında audience olarak kullanılır
GOOGLE_OAUTH_CLIENT_ID=
APPLE_SERVICE_ID=
# İstemci (Vite): tanımsızsa giriş düğmeleri demo profiliyle tamamlanır
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_SERVICE_ID=

# İstemcinin API'yi nerede arayacağı. Vite proxy'si /api'yi zaten
# yönlendiriyor; ayrı bir alan adı kullanacaksanız burayı doldurun.
VITE_API_URL=
