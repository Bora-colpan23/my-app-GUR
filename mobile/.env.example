# Supabase bağlantısı — `npm run supabase:kur` (depo kökünden) bu dosyanın
# gerçeğini (mobile/.env) kendisi yazar. Elle doldurmak isterseniz:
#   Supabase paneli → Project Settings → API
#
# YALNIZCA genel (anon / publishable) anahtar. SERVICE ANAHTARINI buraya
# YAZMAYIN: mağaza paketinin içindeki her şey okunabilir; veriyi RLS korur.
EXPO_PUBLIC_SUPABASE_URL=https://<proje-kodu>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
