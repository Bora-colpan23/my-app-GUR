{
  "expo": {
    "name": "GUR",
    "slug": "gur",
    "scheme": "gur",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDFBF7",
    "primaryColor": "#FF6600",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "app.gur.mobile",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "CFBundleDisplayName": "GUR",
        "NSLocationWhenInUseUsageDescription": "Yakınındaki restoranları sıralamak ve mekânda bulunduğunu doğrulayıp yorum kilidini açmak için konumun kullanılır. Ham koordinatın sunucuya gönderilmez."
      }
    },
    "android": {
      "package": "app.gur.mobile",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#FDFBF7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": { "favicon": "./assets/favicon.png", "bundler": "metro" },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF7"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki restoranları sıralamak ve mekânda bulunduğunu doğrulamak için konumun kullanılır.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://api.gur.app"
    }
  }
}
